    "If sign-in doesn't work, paste your existing Claude Code access token instead (it has the required user:profile scope). This command copies it to your clipboard:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls die Anmeldung nicht klappt, füge stattdessen deinen vorhandenen Claude-Code-Token ein (er hat den nötigen user:profile-Scope). Dieser Befehl kopiert ihn in die Zwischenablage:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el inicio de sesión no funciona, pega tu token de acceso de Claude Code (tiene el ámbito user:profile necesario). Este comando lo copia al portapapeles:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la connexion échoue, colle plutôt ton jeton d'accès Claude Code existant (il a le scope user:profile requis). Cette commande le copie dans le presse-papiers :"
          }
        }
      }
    },
